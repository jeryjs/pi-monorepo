{
  "name": "@jeryjs/pi-bg-terminal",
  "version": "3.0.0",
  "description": "Background commands and attachable PTY/TUI sessions for Pi, exposed through a single bg_terminal tool",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "piBuild": {
    "bundlePackages": [
      "@99percentpeople/pi-shared-settings"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "background-terminal",
    "background-tasks",
    "pty",
    "tui"
  ],
  "author": "jeryjs",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@99percentpeople/pi-shared-settings": "0.1.4",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.2.0-beta.14"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
