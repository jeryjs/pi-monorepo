# Dependencies
node_modules/

# Machine-local runtime state (absolute paths, applied-patch fingerprints,
# conflict history). Regenerated by `node mainrunner.js run`.
state.json
runner.log

# Conflict reports — rendered on every run, opened in the browser on conflict
conflicts.html
conflicts.data.js

# Pre-patch copies of every file the runner touched (can be hundreds of MB)
backups/
